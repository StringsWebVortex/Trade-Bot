{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/StringsWebVortex/Trade-Bot/.claude/skills/quality-engineering/schemas/change_plan.schema.json",
  "title": "Trade-Bot quality-engineering change plan",
  "description": "A change plan records traceable requirements, decisive verification, the failure mode, and rollback context before implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "change_class",
    "requirements",
    "verification",
    "failure_mode"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "change_class": {
      "type": "string",
      "enum": [
        "defect_fix",
        "production_behaviour",
        "security_change",
        "test_only",
        "tooling",
        "documentation"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/requirement"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/verification"
      }
    },
    "failure_mode": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "blast_radius": {
      "type": "string",
      "enum": [
        "funds",
        "credentials",
        "production",
        "customer_data",
        "availability",
        "bounded",
        "unknown"
      ]
    },
    "rollback": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "new"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(INV-[0-9]{3}|REG-[0-9]{4}|SEC-[0-9]{4}|[A-Z]{3,5}-[0-9]{3})$"
        },
        "new": {
          "type": "boolean"
        },
        "status_after": {
          "type": "string",
          "enum": [
            "planned",
            "partial",
            "verified",
            "accepted_gap"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "test_type",
        "decides"
      ],
      "properties": {
        "test": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(tests/[A-Za-z0-9_/-]+\\.py(::[A-Za-z0-9_:]+)?|frontend/src/[A-Za-z0-9_/-]+\\.test\\.jsx?)$"
        },
        "test_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "decides": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "new": {
          "type": "boolean"
        }
      }
    }
  }
}
