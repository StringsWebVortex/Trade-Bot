{
  "_registry": "GOV-011, GOV-012 (config/quality_registry.json).",
  "$schema": "https://trade-bot.local/schemas/command-policy/1.0.0.json",
  "policy_version": "1.3.0",
  "enforcement": "block",
  "_enforcement_values": [
    "block",
    "warn"
  ],
  "_enforcement_note": "block: refuse the tool call and explain. warn: allow but inject the reason as feedback. There is no agent-controlled off mode; policy controls are security boundaries and can only be changed in repository source under review.",
  "destructive": {
    "enabled": true,
    "_note": "Destructive commands are refused outright. They are not blocked because they are forbidden -- they are blocked because they must be run through common/shell_exec.run() with classification='destructive' and confirm_destructive=True, which records the authorization. The hook names that path in its refusal.",
    "allow_marker": "TB_DESTRUCTIVE_OK=1",
    "_allow_marker_note": "Prefixing a command with this marker documents that a human authorized this specific irreversible action. The marker is deliberately noisy so it cannot be added by habit."
  },
  "secret_echo": {
    "enabled": true,
    "_note": "Refuse commands that would print a credential store straight into the transcript, which is how a secret ends up in an LLM context and in the session log.",
    "patterns": [
      "\\bcat\\b[^|]*\\.(env|pem|key|p12|pfx|keystore)\\b",
      "\\b(head|tail|sed|awk|grep|egrep|rg|less|more|bat|strings|xxd|od|cut|sort|nl|tac|base64)\\b[^|;&]*\\.(env(?!\\.(example|sample|template))|pem|key|p12|pfx|keystore)\\b",
      "\\b(head|tail|sed|awk|grep|egrep|rg|less|more|bat|strings|xxd|od|cut|sort|nl|tac|base64)\\b[^|;&]*(id_rsa|id_ed25519|\\.netrc|\\.pgpass)\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\b[\\s\\S]*\\bopen\\([^)]*\\.(env(?!\\.(example|sample|template))|pem|key|p12|pfx|keystore)\\b",
      "\\bcat\\b[^|]*(id_rsa|id_ed25519|credentials|\\.netrc|\\.pgpass)\\b",
      "\\becho\\b[^|]*\\$(MONGODB_URI|GITHUB_TOKEN|ANTHROPIC_API_KEY|AWS_SECRET_ACCESS_KEY)\\b",
      "\\b(env|printenv)\\b\\s*$",
      "\\bgit\\s+config\\b[^|]*(credential|url\\..*insteadOf)",
      "\\baws\\s+configure\\s+get\\b",
      "\\bgh\\s+auth\\s+token\\b"
    ]
  },
  "ci_log_access": {
    "enabled": true,
    "_note": "The .github/workflows/ci-diagnostics.yml collector publishes the finalized filtered report. Use only ./scripts/prfail --pr <PR_NUMBER>; direct Actions data, annotations, logs, artifacts, check results, local check execution, and legacy PR-comment reads remain blocked.",
    "message": "THAPPAR \u2014 CI DIAGNOSTIC ACCESS BLOCKED. Use only: ./scripts/prfail --pr <PR_NUMBER>. Direct or alternative diagnostic retrieval is prohibited.",
    "_hard_deny_note": "Raw check/log reads are denied before the allowlist. Only the exact ./scripts/prfail --pr <positive-decimal> command is exempt; local check wrappers and shell wrappers are not implemented.",
    "hard_deny_patterns": [
      "\\bgh\\s+(pr|run|repo)\\b[^|]*--json\\b[^|]*\\b(statusCheckRollup|checkRuns|checkSuites|jobs|workflowRuns)\\b",
      "\\bgh\\s+pr\\s+checks\\b"
    ],
    "_allowed_note": "Exactly one diagnostic route is permitted: ./scripts/prfail --pr followed by a positive decimal PR number.",
    "allowed_patterns": [
      "^\\s*\\./scripts/prfail\\s+--pr\\s+[1-9][0-9]*\\s*$"
    ],
    "denied_tool_patterns": [
      "mcp__*__*workflow*log*",
      "mcp__*__*workflow*artifact*",
      "mcp__*__*workflow*job*",
      "mcp__*__*workflow*run*",
      "mcp__*__*check*run*",
      "mcp__*__*check*suite*",
      "mcp__*__*annotation*",
      "mcp__*__*artifact*",
      "mcp__*__*actions*",
      "mcp__*__*status*check*",
      "mcp__*__*workflow*step*"
    ],
    "denied_command_patterns": [
      "\\bgh\\s+run\\s+\\w+\\b",
      "\\bgh\\s+workflow\\s+\\w+\\b",
      "\\bgh\\s+pr\\s+checks\\b",
      "\\bgh\\s+api\\b[^|]*(?:actions|check-runs?|check-suites?|annotations|statuses|workflow_runs|artifacts|jobs)",
      "\\b(?:curl|wget|http|https|xh)\\b[^|]*(?:api\\.github\\.com|github\\.com/)[^|]*(?:actions|check-runs?|check-suites?|annotations|statuses|workflow_runs|artifacts|jobs)",
      "\\b(?:python(?:3)?(?:\\.\\d+)?|node|ruby|perl|php|go)\\b[^|]*(?:urllib|requests|httpx|fetch\\(|axios|Net::HTTP|curl_easy|github\\.com|api\\.github\\.com)[^|]*(?:actions|check-runs?|check-suites?|annotations|statuses|workflow_runs|artifacts|jobs)",
      "\\b(?:jq|yq)\\b[^|]*(?:workflow|check_run|check_suite|artifact|annotation|conclusion|statusCheckRollup)",
      "\\b(?:act|gh-runner|actions-runner)\\b"
    ],
    "_banned_note": "Mirrors common.command_schema.CI_LOG_PATTERNS; tests require the shared classifier and JSON fallback to agree. The PreToolUse hook independently fails closed for all unapproved tools and shell commands.",
    "banned_patterns": [
      "\\bgh\\s+run\\s+(view|list|download|watch|rerun|cancel|delete)\\b",
      "\\bgh\\s+workflow\\s+(run|view|list)\\b",
      "\\bgh\\s+pr\\s+checks\\b",
      "\\bgh\\s+cache\\s+(list|delete)\\b",
      "\\bgh\\s+api\\b[^|]*/actions/",
      "\\bgh\\s+api\\b[^|]*/check-runs?\\b",
      "\\bgh\\s+api\\b[^|]*/check-suites?\\b",
      "\\bgh\\s+api\\b[^|]*/commits/[^/\\s]+/(status|check-runs)\\b",
      "\\bgh\\s+api\\b[^|]*/statuses/",
      "\\bgh\\s+(pr|run)\\b[^|]*--json\\b[^|]*\\b(statusCheckRollup|checkRuns|jobs|workflowRuns)\\b",
      "\\b(?:curl|wget)\\b[^|]*(?:api\\.github\\.com|github\\.com/)[^|]*(?:actions|check-runs|check-suites|annotations|statuses|workflow_runs)\\b",
      "\\b(?:https?|xh)\\b[^|]*(?:api\\.github\\.com|github\\.com/)[^|]*(?:actions|check-runs?|check-suites?|annotations|statuses|workflow_runs|artifacts|jobs)\\b",
      "\\bact\\b\\s+-",
      "\\bgh\\s+pr\\s+view\\b[^|]*(?:--comments\\b|--json\\b[^|]*\\bcomments\\b)",
      "\\bgh\\s+issue\\s+view\\b[^|]*(?:--comments\\b|--json\\b[^|]*\\bcomments\\b)",
      "\\bgh\\s+api\\b[^|]*/(?:issues/(?:comments|\\d+/comments)|pulls/\\d+/comments)\\b",
      "\\b(?:curl|wget)\\b[^|]*/(?:issues/\\d+/comments|pulls/\\d+/comments)\\b",
      "\\bgh\\s+api\\b[^|]*\\bgraphql\\b",
      "\\b(?:curl|wget)\\b[^|]*/graphql\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-c\\b.*(?:api\\.github\\.com|github\\.com/|graphql)\\b",
      "\\bnode\\s+-e\\b.*(?:api\\.github\\.com|github\\.com/|graphql)\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+scripts/(?:local_checks|ci_verdict|ci_diagnostics)\\.py\\b",
      "\\b(?:\\./)?scripts/prfail\\b",
      "(?:^|[;&|]\\s*)\\./scripts/ci_diagnostics\\.py\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-m\\s+scripts\\.ci_diagnostics\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-c\\b[\\s\\S]*(?:\\bscripts[./](?:ci_diagnostics|ci_verdict|local_checks|prfail)\\b|\\bfrom\\s+scripts\\s+import\\b[\\s\\S]*\\b(?:ci_diagnostics|ci_verdict|local_checks)\\b)",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-\\s*<<[\\s\\S]*(?:\\bscripts[./](?:ci_diagnostics|ci_verdict|local_checks|prfail)\\b|\\bfrom\\s+scripts\\s+import\\b[\\s\\S]*\\b(?:ci_diagnostics|ci_verdict|local_checks)\\b)",
      "\\b(?:python(?:3)?(?:\\.\\d+)?|node|ruby|perl|php|go)\\b[^|]*(?:urllib|requests|httpx|fetch\\(|axios|Net::HTTP|curl_easy|github\\.com|api\\.github\\.com)[^|]*(?:actions|check-runs?|check-suites?|annotations|statuses|workflow_runs|artifacts|jobs)"
    ]
  },
  "local_checks": {
    "enabled": true,
    "wrapper": "scripts/local_checks.py",
    "prepare_command": "DISABLED: superseded by ./scripts/prfail --pr <PR_NUMBER>",
    "run_command": "DISABLED: GitHub Actions is the sole test/build/check execution path.",
    "rule": "GitHub Actions is the sole execution path for tests, builds, lint, security scans, workflow validation, and quality gates. The legacy local_checks.py prepare notice reader is retired for agent use. The only permitted diagnostic retrieval command is ./scripts/prfail --pr <PR_NUMBER>, which reads the finalized filtered Check Run report; the run subcommand remains disabled.",
    "blocked_patterns": [
      "(?:^|[;&|]\\s*)(?:uv\\s+run\\s+)?(?:[^\\s;&|]+/)?pytest(?:\\s|$)",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-m\\s+pytest\\b",
      "\\b(?:python(?:3)?(?:\\.\\d+)?\\s+-m\\s+)?unittest\\b",
      "\\b(?:tox|nox)\\b",
      "\\bcoverage(?:\\s+(?:run|combine|report|html|xml|erase))?\\b",
      "\\bruff\\s+(?:check|format)\\b",
      "\\b(?:mypy|pyright|flake8|pylint|black|isort)\\b",
      "\\b(?:bandit|pip-audit|safety|semgrep|trivy)\\b",
      "\\b(?:npx\\s+)?(?:vitest|jest|playwright|cypress)\\b",
      "\\b(?:npm|pnpm|yarn)\\s+(?:test|run\\s+(?:test|build|lint|check)|build|lint|check)\\b",
      "\\b(?:cargo\\s+(?:test|build|clippy)|go\\s+(?:test|build|vet))\\b",
      "\\b(?:make|gmake)\\s+(?:test|build|lint|check|ci)\\b",
      "\\b(?:cmake\\s+--build|ninja(?:\\s|$))",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-m\\s+build\\b",
      "\\bpre-commit\\s+run\\b",
      "\\b(?:actionlint|shellcheck)\\b",
      "\\.claude/skills/quality-engineering/scripts/qe_gate\\.py\\b",
      "\\bscripts/arch_gate\\.sh\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+(?:-m\\s+)?tests?/[^ \\t;&|]*\\.py\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-m\\s+tests?(?:\\.|\\s)",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+-m\\s+compileall\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+scripts/generate_(?:math|quality)_docs\\.py\\s+--check\\b",
      "\\b(?:bash|sh)\\s+[^;&|]*(?:test|tests|testing|build|lint|check|quality[-_]gate|security[-_]scan)[^;&|]*\\.sh\\b",
      "\\bnode\\s+[^;&|]*(?:test|tests|testing|build|lint|check)[^;&|]*\\.(?:js|mjs|cjs|ts)\\b",
      "\\bpython(?:3)?(?:\\.\\d+)?\\s+(?:[^\\s;&|]+/)?(?!local_checks\\.py\\b)[^\\s;&|]*(?:test|tests|build|lint|check|quality_gate|security_scan)[^\\s;&|]*\\.py\\b",
      "\\b(?:docker\\s+(?:compose\\s+)?build|podman\\s+build)\\b",
      "\\b(?:cargo\\s+fmt|go\\s+fmt)\\b",
      "\\b(?:eslint|prettier|tsc)\\b",
      "\\bgit\\s+diff\\b[^;&|]*--check\\b",
      "\\b(?:npm|pnpm|yarn)\\s+(?:run\\s+)?(?:typecheck|type-check|type-checks|lint:check)\\b"
    ],
    "github_only": true
  },
  "duplicate_delivery": {
    "enabled": false,
    "threshold": 0.25,
    "denominator": "proposed-delivery-comparable-content-units",
    "filename_independent": true,
    "enforcement": "not enabled as a repository policy until a registry-backed deciding test can verify the host-level enforcement contract; the separate host hook is outside this worktree",
    "sources": [
      "accessible Trade-Bot worktrees",
      "tracked and untracked repository files",
      "reachable Git refs and history",
      "available local Claude Trade-Bot conversation records"
    ],
    "persistent_index": "host-level index outside branch/worktree",
    "stale_or_unavailable_index": "block delivery-shaped mutations",
    "limitations": "Policy is deliberately disabled here: repository CI cannot verify the external host hook or ChatGPT-hosted conversation history."
  },
  "_gh_note": "CI run data and arbitrary PR-comment reads are blocked. Use the exact ./scripts/prfail --pr <PR_NUMBER> report command; ordinary PR metadata and comment writes remain separately governed.",
  "github_route": {
    "contract": ".claude/hooks/_gh_contract.py",
    "_note": "The GitHub tool contract is code-owned. This section is documentary; it cannot widen a route.",
    "ci_notice_route": "./scripts/prfail --pr <PR_NUMBER> (finalized filtered Check Run report)",
    "pr_comment_reads": "deny (pull_request_read method=get_comments is refused)"
  },
  "_removed_sections_note": "SCR-006: bounded_output, observation_boundary and ci_observability had no consumer; the hooks read config/observation_boundary.json (80-line limits). CI live-watch bans live in ci_log_access and common/command_schema.py."
}
